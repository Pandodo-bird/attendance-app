// CHANGE: attendance/{attendanceId} create — teachers AND secretaries can now create sessions.
// Removed isTeacher()/isSecretary() role lookups that caused "missing permission" errors.
// Ownership alone prevents impersonation: secretaryUid == uid OR teacherId == uid.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user's UID
    function getUid() {
      return request.auth.uid;
    }
    
    // Helper function to check if user is a teacher
    function isTeacher() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'teacher';
    }
    
    // Helper function to check if user is a secretary
    function isSecretary() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'secretary';
    }
    
    // ==================== Users Collection ====================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getUid() == userId;
      allow delete: if false;
    }
    
    // ==================== Sections Collection ====================
    match /sections/{sectionId} {
      allow read: if isAuthenticated() &&
                     (resource.data.teacherId == getUid() || isSecretary());
      allow create: if isAuthenticated() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() &&
                       resource.data.teacherId == getUid();

      match /students/{studentLrn} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() &&
                                         get(/databases/$(database)/documents/sections/$(sectionId)).data.teacherId == getUid();
      }
    }
    
    // ==================== Appointments Collection ====================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && 
                     (resource.data.teacherId == getUid() || 
                      resource.data.secretaryUid == getUid());
      allow create: if isAuthenticated() && 
                       isTeacher() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
    }
    
    // ==================== Attendance Collection ====================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() &&
                     (resource == null ||
                      resource.data.teacherId == getUid() ||
                      resource.data.secretaryUid == getUid());
      allow create: if isAuthenticated() &&
                       (
                         request.resource.data.secretaryUid == getUid() ||
                         request.resource.data.teacherId == getUid()
                       );
      allow update: if isAuthenticated() &&
                       (resource.data.secretaryUid == getUid() || resource.data.teacherId == getUid());
      allow delete: if false;

      match /records/{recordId} {
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/attendance/$(attendanceId)).data.teacherId == getUid() ||
                        get(/databases/$(database)/documents/attendance/$(attendanceId)).data.secretaryUid == getUid());
        allow create, update, delete: if false;
      }
    }

    // ==================== AttendanceRecords Collection ====================
    match /attendanceRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       (isSecretary() || request.resource.data.teacherId == getUid());
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid();
      allow delete: if false;
    }

    // ==================== StudentSummaries Collection ====================
    match /studentSummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       (
                         isSecretary() ||
                         get(/databases/$(database)/documents/sections/$(request.resource.data.sectionId)).data.teacherId == getUid()
                       );
      allow update: if isAuthenticated() &&
                       (
                         isSecretary() ||
                         get(/databases/$(database)/documents/sections/$(resource.data.sectionId)).data.teacherId == getUid()
                       );
      allow delete: if false;
    }
  }
}