rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user's UID
    function getUid() {
      return request.auth.uid;
    }
    
    // Helper function to check if user is a teacher
    function isTeacher() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'teacher';
    }
    
    // Helper function to check if user is a secretary
    function isSecretary() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'secretary';
    }
    
    // ==================== Users Collection ====================
    match /users/{userId} {
      // Allow authenticated users to read any user profile (needed for checking secretary existence)
      allow read: if isAuthenticated();
      // TEMPORARILY OPEN: Allow authenticated users to create secretary profiles for testing
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getUid() == userId;
      allow delete: if false;
    }
    
    // ==================== Sections Collection ====================
    match /sections/{sectionId} {
      // Teachers can read their own sections, secretaries can read any section (app logic filters to their appointment)
      allow read: if isAuthenticated() &&
                     (resource.data.teacherId == getUid() || isSecretary());
      allow create: if isAuthenticated() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() &&
                       resource.data.teacherId == getUid();

      // Students subcollection
      match /students/{studentLrn} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() &&
                                         get(/databases/$(database)/documents/sections/$(sectionId)).data.teacherId == getUid();
      }
    }
    
    // ==================== Appointments Collection ====================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && 
                     (resource.data.teacherId == getUid() || 
                      resource.data.secretaryUid == getUid());
      allow create: if isAuthenticated() && 
                       isTeacher() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
    }
    
    // ==================== Attendance Collection ====================
    match /attendance/{attendanceId} {
      // Secretaries can read/write their own attendance, teachers can read attendance for their sections
      // Note: resource.data is null for non-existent documents, so allow read when checking existence
      allow read: if isAuthenticated() &&
                     (resource.data == null ||
                      resource.data.teacherId == getUid() ||
                      resource.data.secretaryUid == getUid());
      allow create: if isAuthenticated() &&
                       isSecretary() &&
                       request.resource.data.secretaryUid == getUid();
      allow update: if isAuthenticated() &&
                       (resource.data.secretaryUid == getUid() || resource.data.teacherId == getUid());
      allow delete: if false;

      match /records/{recordId} {
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/attendance/$(attendanceId)).data.teacherId == getUid() ||
                        get(/databases/$(database)/documents/attendance/$(attendanceId)).data.secretaryUid == getUid());
        allow create, update, delete: if false;
      }
    }

    // ==================== AttendanceRecords Collection ====================
    match /attendanceRecords/{recordId} {
      // Teachers can read records for their sections, secretaries can read their own records
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isSecretary();
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid();
      allow delete: if false;
    }

    // ==================== StudentSummaries Collection ====================
    match /studentSummaries/{summaryId} {
      // Teachers can read summaries for their sections, secretaries can read their section's summaries
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isSecretary();
      allow update: if isAuthenticated() &&
                       (
                         isSecretary() ||
                         get(/databases/$(database)/documents/sections/$(resource.data.sectionId)).data.teacherId == getUid()
                       );
      allow delete: if false;
    }
  }
}
