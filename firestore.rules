// Shared section-day attendance rules.
// Sessions are now identified by section + date, while appointments remain section-based access metadata.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user's UID
    function getUid() {
      return request.auth.uid;
    }
    
    // Helper function to check if user is a teacher
    function isTeacher() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'teacher';
    }
    
    // Helper function to check if user is a secretary
    function isSecretary() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(getUid())).data.role == 'secretary';
    }

    function isSectionTeacher(sectionId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/sections/$(sectionId)).data.teacherId == getUid();
    }

    function isAttendanceTeacher() {
      return isAuthenticated() &&
             resource.data.teacherId == getUid();
    }

    function isRequestAttendanceTeacher() {
      return isAuthenticated() &&
             request.resource.data.teacherId == getUid();
    }

    function isAttendanceSecretary() {
      return isAuthenticated() &&
             resource.data.secretaryUid != null &&
             resource.data.secretaryUid == getUid();
    }

    function isRequestAttendanceSecretary() {
      return isAuthenticated() &&
             request.resource.data.secretaryUid != null &&
             request.resource.data.secretaryUid == getUid();
    }

    function isSecretarySubmittingOpenAttendance() {
      return isAuthenticated() &&
             isSecretary() &&
             resource.data.status == 'open' &&
             request.resource.data.status == 'locked' &&
             request.resource.data.submittedByUid == getUid() &&
             request.resource.data.submittedByRole == 'secretary';
    }
    
    // ==================== Users Collection ====================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getUid() == userId;
      allow delete: if false;
    }
    
    // ==================== Sections Collection ====================
    match /sections/{sectionId} {
      allow read: if isAuthenticated() &&
                     (resource.data.teacherId == getUid() || isSecretary());
      allow create: if isAuthenticated() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() &&
                       resource.data.teacherId == getUid();

      match /students/{studentLrn} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() &&
                                         get(/databases/$(database)/documents/sections/$(sectionId)).data.teacherId == getUid();
      }
    }
    
    // ==================== Appointments Collection ====================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && 
                     (resource.data.teacherId == getUid() || 
                      resource.data.secretaryUid == getUid());
      allow create: if isAuthenticated() && 
                       isTeacher() &&
                       request.resource.data.teacherId == getUid();
      allow update: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
      allow delete: if isAuthenticated() && 
                       resource.data.teacherId == getUid();
    }
    
    // ==================== Attendance Collection ====================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() &&
                     (
                       resource == null ||
                       isAttendanceTeacher() ||
                       isAttendanceSecretary() ||
                       isSecretary()
                     );
      allow create: if isAuthenticated() &&
                        (
                          (isTeacher() && isRequestAttendanceTeacher() && isSectionTeacher(request.resource.data.sectionId)) ||
                          (isSecretary() && isRequestAttendanceSecretary())
                        );
      allow update: if isAuthenticated() &&
                       (
                         isAttendanceTeacher() ||
                         isSecretarySubmittingOpenAttendance() ||
                         (
                           isAttendanceSecretary() &&
                           resource.data.status != 'locked' &&
                           request.resource.data.status != 'locked'
                         )
                       );
      allow delete: if false;

      match /records/{recordId} {
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/attendance/$(attendanceId)).data.teacherId == getUid() ||
                        get(/databases/$(database)/documents/attendance/$(attendanceId)).data.secretaryUid == getUid());
        allow create, update, delete: if false;
      }
    }

    // ==================== AttendanceRecords Collection ====================
    match /attendanceRecords/{recordId} {
      allow read: if isAuthenticated() &&
                     (isSectionTeacher(resource.data.sectionId) ||
                      (isSecretary() && resource.data.recordedByUid == getUid()));
      allow create: if isAuthenticated() &&
                       (
                         (isTeacher() && request.resource.data.teacherId == getUid() && isSectionTeacher(request.resource.data.sectionId)) ||
                         (isSecretary() && request.resource.data.recordedByUid == getUid())
                       );
      allow update: if isAuthenticated() &&
                       resource.data.teacherId == getUid() &&
                       isSectionTeacher(resource.data.sectionId);
      allow delete: if false;
    }

    // ==================== StudentSummaries Collection ====================
    match /studentSummaries/{summaryId} {
      allow read: if isAuthenticated() &&
                     (isSectionTeacher(resource.data.sectionId) || isSecretary());
      allow create: if isAuthenticated() &&
                        (
                          (isSecretary()) ||
                          isSectionTeacher(request.resource.data.sectionId)
                        );
      allow update: if isAuthenticated() &&
                        (
                          (isSecretary()) ||
                          isSectionTeacher(resource.data.sectionId)
                        );
      allow delete: if false;
    }
  }
}
